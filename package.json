{
  "name": "@dbydd/hindsight-omp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "omp 的 Hindsight 记忆插件：hindsight:// 资源树 + 单工具 judge 操作面。",
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@oh-my-pi/pi-agent-core": "*",
    "@oh-my-pi/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-agent-core": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "ssot:check": "bun ssot/check.ts",
    "ssot:gen": "bun ssot/gen.ts",
    "ssot:verify": "bun ssot/check.ts && bun ssot/gen.ts --check",
    "verify": "tsc -p tsconfig.json && bun ssot/check.ts && bun ssot/gen.ts --check"
  },
  "devDependencies": {
    "@oh-my-pi/pi-agent-core": "^18.14.2",
    "@oh-my-pi/pi-coding-agent": "^18.14.2",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6"
  }
}
