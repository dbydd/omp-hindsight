{
  "name": "@dbydd/omp-hindsight",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "description": "Hindsight memory plugin for oh-my-pi (omp): virtual hindsight:// resource tree and single-tool judge routing.",
  "license": "MIT",
  "author": "dbydd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbydd/omp-hindsight.git"
  },
  "homepage": "https://github.com/dbydd/omp-hindsight#readme",
  "bugs": {
    "url": "https://github.com/dbydd/omp-hindsight/issues"
  },
  "keywords": [
    "omp",
    "oh-my-pi",
    "hindsight",
    "memory",
    "ai-agent",
    "knowledge-base"
  ],
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "packs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@oh-my-pi/pi-agent-core": "*",
    "@oh-my-pi/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-agent-core": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test:core": "bun test tests/core-foundation.test.ts",
    "test:pack": "bun test tests/prompt-pack.test.ts",
    "test:adapter": "bun test tests/adapter-layer.test.ts",
    "test:container": "bun test tests/container-integration.test.ts",
    "test:judge": "bun test tests/decision-unit.test.ts tests/decision-paths.test.ts",
    "test:judge:unit": "bun test tests/decision-unit.test.ts",
    "test:judge:e2e": "bun test tests/decision-paths.test.ts",
    "test:judge:family": "bun test tests/decision-unit.test.ts -t \"action_family\"",
    "test:judge:depth": "bun test tests/decision-unit.test.ts -t \"retrieval_depth\"",
    "test:judge:kb": "bun test tests/decision-unit.test.ts -t \"knowledge_base_action\"",
    "test:judge:mm": "bun test tests/decision-unit.test.ts -t \"mental_model_action\"",
    "test:judge:ops": "bun test tests/decision-unit.test.ts -t \"operation_action\"",
    "test:judge:bank": "bun test tests/decision-unit.test.ts -t \"target_bank\"",
    "ssot:check": "bun ssot/check.ts",
    "ssot:gen": "bun ssot/gen.ts",
    "ssot:verify": "bun ssot/check.ts && bun ssot/gen.ts --check",
    "verify": "tsc -p tsconfig.json && bun ssot/check.ts && bun ssot/gen.ts --check && bun run test:core && bun run test:adapter && bun run test:pack"
  },
  "devDependencies": {
    "@oh-my-pi/pi-agent-core": "^18.14.2",
    "@oh-my-pi/pi-coding-agent": "^18.14.2",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6"
  },
  "dependencies": {
    "@vectorize-io/hindsight-client": "^1.1.0"
  }
}
